# Copy to `.env` and fill in your Auth0 Regular Web Application credentials.
#
# Passkeys require a custom domain and a Relying Party ID (see the home page and
# README). AUTH0_DOMAIN must be your Auth0 CUSTOM domain, and APP_BASE_URL must
# be the HTTPS origin the browser reaches the app on (not plain localhost).
AUTH0_DOMAIN=your-custom-domain.example.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace-with-a-32-byte-random-value-000000000000
APP_BASE_URL=https://your-app-domain.example.com

# In your Auth0 application settings:
#   Allowed Callback URLs: https://your-app-domain.example.com/auth/callback
#   Allowed Logout URLs:   https://your-app-domain.example.com
